# --- Morrowglass project rules ---
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
.mypy_cache/
# Large or derived data: never committed (hashes live in data/manifests and reports/)
data/raw/
data/processed/
artifacts/
*.pt
*.safetensors
*.ckpt
*.npy
# Smoke outputs are regenerated by `make smoke`
reports/smoke/
# Derived SQLite index (rebuilt from reports/runs/*.json)
*.sqlite
*.sqlite3
*.db
# Run control files
reports/runs/*/STOP
# Web
web/node_modules/
web/dist/
web/.vite/
*.log
.DS_Store

# --- baseline added by new-github-project.sh: never commit secrets, local data or dependencies ---
.env
.env.*
!.env.example
*.pem
*.key
secrets*
*.sqlite
*.sqlite-*
*.db
node_modules/
.venv/
__pycache__/
*.pyc
.DS_Store

# Local tooling
.claude/
.venv-lmeval/
